{
  "name": "subtrack",
  "private": true,
  "workspaces": [
    "shared",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm test -w shared && npm test -w frontend",
    "typecheck": "npm run typecheck -w shared",
    "db:push": "supabase db push",
    "db:test": "supabase test db --linked",
    "db:lint": "supabase db lint --linked --level warning",
    "db:types": "supabase gen types typescript --linked --schema public > shared/src/database.types.ts",
    "gen:sql": "node shared/scripts/to-sql.ts"
  }
}
