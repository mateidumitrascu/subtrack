# Copy to backend/.env (gitignored) and fill in. Values come from the Supabase
# dashboard of the dev project. Share the real secrets privately (e.g. a
# password manager), never in Git, chat or screenshots.

# --- Supabase API (Project Settings > API Keys) ------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key: for normal requests. Create the client per request with the
# user's access token (Authorization: Bearer <jwt> from the frontend), so row
# level security applies and the RPCs see auth.uid().
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key: BYPASSES row level security and has no auth.uid(). Only for
# trusted server jobs (cron, admin scripts). Never send it to a client or log it.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Direct Postgres (optional; prefer the RPCs) ------------------------------
# Dashboard > Connect > Transaction pooler. Connects as `postgres`, which also
# bypasses RLS, so filter by user yourself if you use it.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres

# --- Server ------------------------------------------------------------------
PORT=3000
# Allowed CORS origin (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173
