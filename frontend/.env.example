# Copy to frontend/.env (gitignored) and fill in from the Supabase dashboard:
# Project Settings > API Keys. Use the PUBLISHABLE key only. The secret key
# bypasses row level security and must never ship to the browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
