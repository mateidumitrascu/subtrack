{
  // Runtime-neutral on purpose: no DOM and no Node types, so code that only
  // works in a browser (window, localStorage) or only in Node fails to compile
  // here instead of breaking an Edge Function or the backend at runtime.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
